---
import { site } from '../data/site';

/* One row template, three data rows â€” the icon differs per row, so it travels with the data
   as the inner markup of a shared <svg>. */
const rows = [
  {
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    icon: '<path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/>',
  },
  {
    label: 'Mobile',
    value: site.phones.mobile.label,
    href: site.phones.mobile.href,
    icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.08 4.18 2 2 0 0 1 4.06 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.68 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.2a2 2 0 0 1 2.11-.45c.91.32 1.85.55 2.81.68A2 2 0 0 1 22 16.92z"/>',
  },
  {
    label: 'Ufficio',
    value: site.phones.office.label,
    href: site.phones.office.href,
    icon: '<path d="M3 5h18v14H3z"/><path d="M7 9h.01M7 13h10"/>',
  },
];
---

<!-- CONTATTI -->
<section id="contatti" class="section">
  <div class="shell grid items-center gap-[clamp(32px,5vw,64px)] wide:grid-cols-2">
    <div>
      <h2 class="section-title gs-up">Contattaci</h2>
      <p class="section-lede gs-up">Scrivici o chiamaci e dicci che auto hai in testa. Ti facciamo sapere quanto costa e quanto tempo ci vuole.</p>
      <p class="gs-up mt-6 text-subtle text-[.94rem]">Preferisci fare tutto dall'app? <a href="#app" class="text-accent font-semibold transition-colors duration-200 ease-brand hover:text-accent-hover focus-visible:text-accent-hover active:text-accent-hover">Scaricala qui</a>.</p>
    </div>

    <div class="gs-scale bg-white border border-hair rounded-brand shadow-card overflow-hidden">
      {rows.map((row) => (
        <a
          class="group flex items-center gap-4 min-h-[68px] px-[18px] py-4 border-t border-hair first:border-t-0 transition-colors duration-200 ease-brand hover:bg-[#FAFBFC] focus-visible:bg-[#FAFBFC] active:bg-mist tablet:min-h-[76px] tablet:px-[22px] tablet:py-[18px]"
          href={row.href}
        >
          <span class="flex-none w-11 h-11 rounded-xl grid place-items-center bg-accent-soft border border-accent/20 transition-[background-color,border-color] duration-200 group-hover:bg-accent group-hover:border-accent group-focus-visible:bg-accent group-focus-visible:border-accent">
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke-width="2"
              class="stroke-accent transition-[stroke] duration-200 group-hover:stroke-white group-focus-visible:stroke-white"
              aria-hidden="true"
              set:html={row.icon}
            />
          </span>
          <span class="flex-1 min-w-0">
            <small class="block text-[.72rem] font-semibold tracking-[.12em] uppercase text-subtle mb-0.5">{row.label}</small>
            <b class="block font-body text-base font-medium text-ink [overflow-wrap:anywhere] tablet:text-[1.06rem]">{row.value}</b>
          </span>
          <svg
            class="hidden flex-none text-accent opacity-0 -translate-x-[6px] transition-[opacity,transform] duration-[250ms] ease-brand group-hover:opacity-100 group-hover:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:translate-x-0 tablet:block"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          ><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      ))}
    </div>
  </div>
</section>
