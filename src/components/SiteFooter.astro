  fb: '<path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.62c-.29-.04-1.29-.12-2.45-.12-2.43 0-4.1 1.48-4.1 4.2v2.2H7.4V13h2.25v8h3.85Z"/>',
  yt: '<path d="M21.6 7.2s-.2-1.4-.8-2c-.75-.8-1.6-.8-2-.85C16.4 4.2 12 4.2 12 4.2h-.01s-4.39 0-7.19.15c-.4.05-1.25.05-2 .85-.6.6-.79 2-.79 2S1.8 8.85 1.8 10.5v1.54c0 1.65.21 3.3.21 3.3s.19 1.4.79 2c.75.8 1.74.77 2.19.86 1.6.15 6.81.2 6.81.2s4.4-.01 7.2-.16c.4-.05 1.25-.05 2-.85.6-.6.8-2 .8-2s.2-1.65.2-3.3V10.5c0-1.65-.2-3.3-.2-3.3ZM9.93 14.1V8.63l5.62 2.75-5.62 2.72Z"/>',
  tt: '<path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 1 1-1.83-2.48V9.79a5.71 5.71 0 1 0 4.92 5.65V8.98a7.3 7.3 0 0 0 4.02 1.2V7.09a4.26 4.26 0 0 1-2.96-1.27Z"/>',
  wa: '<path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.42 1.27 4.86L2 22l5.32-1.4a9.9 9.9 0 0 0 4.72 1.2c5.5 0 9.96-4.46 9.96-9.96S17.54 2 12.04 2Zm0 18.02a8 8 0 0 1-4.08-1.12l-.29-.17-3.02.79.8-2.95-.19-.3a8.02 8.02 0 0 1 12.4-9.9 8.02 8.02 0 0 1-5.62 13.65Zm4.5-5.86c-.24-.12-1.45-.72-1.68-.8-.22-.08-.39-.12-.55.12-.16.25-.63.8-.77.96-.14.17-.28.18-.52.06-.24-.12-1.03-.38-1.96-1.21-.72-.65-1.21-1.44-1.35-1.69-.14-.24-.02-.38.1-.5.11-.11.25-.29.37-.43.12-.14.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.12-.55-1.33-.75-1.81-.2-.48-.4-.41-.55-.42h-.47c-.16 0-.42.06-.64.3-.22.25-.84.83-.84 2.02 0 1.19.86 2.34.98 2.5.12.17 1.69 2.6 4.1 3.55.57.25 1.02.4 1.37.51.58.18 1.1.16 1.52.1.46-.07 1.45-.6 1.65-1.17.2-.58.2-1.07.14-1.17-.06-.1-.22-.16-.46-.28Z"/>',
};

const hovers: Record<string, string> = {
  ig: 'hover:bg-[image:linear-gradient(45deg,#F58529_0%,#DD2A7B_45%,#8134AF_75%,#515BD4_100%)]',
  fb: 'hover:bg-[#1877F2]',
  yt: 'hover:bg-[#FF0000]',
  /* TikTok's black would vanish on the dark footer, so use its cyan with a dark glyph */
  tt: 'hover:bg-[#25F4EE] hover:text-ink',
  wa: 'hover:bg-[#25D366]',
};

const socials = [
  ...site.socials.map((s) => ({ id: s.id as string, href: s.href as string, label: `${site.name} su ${s.name}` })),
  { id: 'wa', href: site.whatsapp as string, label: 'Scrivici su WhatsApp' },
];

/* WCAG 2.5.8: keep link targets at least 24px tall */
const navLink =
  'inline-block py-1 px-0.5 min-h-6 transition-colors duration-200 hover:text-white focus-visible:text-white active:text-white/70';
const legalLink =
  'inline-block py-[3px] px-px min-h-6 underline transition-colors duration-200 hover:text-white focus-visible:text-white active:text-white/70';
---

<footer class="bg-ink text-white/68 pt-[60px] pb-[34px] text-[0.92rem]">
  <div class="shell">
    <div class="flex justify-between gap-8 flex-wrap pb-8 border-b border-white/12 mb-7">
      <a
        href="/#top"
        aria-label={`${site.name}, torna alla home`}
        class="inline-block transition duration-200 hover:opacity-80 focus-visible:opacity-80 motion-safe:active:scale-[0.98]"
      >
        <img
          src="/images/ready2cars-logo.png"
          alt={site.name}
          width="502"
          height="127"
          class="h-[38px] md:h-[46px] w-auto"
          loading="lazy"
          decoding="async"
        />
      </a>

      <ul class="flex gap-5 flex-wrap list-none">
        {footerNav.map((l) => (
          <li><a href={l.href} class={navLink}>{l.label}</a></li>
        ))}
      </ul>

      <nav class="flex gap-2.5 flex-wrap" aria-label={`${site.name} sui social`}>
        {socials.map((s) => (
          <a
            href={s.href}
            rel="noopener"
            target="_blank"
            aria-label={s.label}
            class:list={[
              'w-[42px] h-[42px] rounded-full grid place-items-center text-white',
              'border border-white/16 bg-white/4 transition duration-200',
              'hover:border-transparent active:scale-95',
              'motion-safe:hover:-translate-y-0.5 motion-safe:focus-visible:-translate-y-0.5',
              hovers[s.id],
            ]}
          >
            <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={glyphs[s.id]} />
          </a>
        ))}
      </nav>
    </div>

    <p class="mb-2.5">P.Iva: {site.vat} · Rea: {site.rea} · Pec: {site.pec}</p>

    <div class="flex justify-between gap-4 flex-wrap items-center text-[0.86rem] text-white/50">
      <span>© {new Date().getFullYear()} {site.legalName}. Tutti i diritti riservati.</span>
      <span>
        <a href="/privacy-policy" class={legalLink}>Privacy Policy</a> ·
        <a href="/cookie-policy" class={legalLink}>Cookie Policy</a> ·
        Foto di <a href="https://www.pexels.com" rel="noopener" class={legalLink}>Pexels</a>
      </span>
    </div>
  </div>
</footer>
