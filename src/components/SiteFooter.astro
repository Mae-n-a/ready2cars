---
import { site } from '../data/site';

/* site.nav has no App entry (the header spy only tracks three sections), so the footer
   list is spelled out here to keep the legacy order Servizi, Perché noi, App, Contatti. */
const footerNav = [
  { label: 'Servizi', href: '/#servizi' },
  { label: 'Perché noi', href: '/#perche' },
  { label: 'App', href: '/#app' },
  { label: 'Contatti', href: '/#contatti' },
];

/* One 42px circle per network. The glyph paths are the legacy inline SVGs; the hover class
   is written out in full so Tailwind's source scan can see each arbitrary value. */
const glyphs: Record<string, string> = {
